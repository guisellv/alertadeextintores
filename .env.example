# Copia este archivo como .env (NUNCA subas el .env a GitHub)

# --- Base de datos ---
# Opción A (nube, ej. Neon): pega aquí la "connection string"
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require

# Opción B (PostgreSQL en tu PC): se usa si DATABASE_URL está vacío
DB_USER=postgres
DB_HOST=localhost
DB_NAME=extintores
DB_PASSWORD=tu-contraseña
DB_PORT=5432

# --- Correo (Gmail) ---
EMAIL_USER=tu-email@gmail.com
# Contraseña de aplicación de Gmail (16 letras), no tu contraseña normal
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx
# Los avisos llegan al correo de cada usuario registrado.
# Opcional: correos EXTRA que también reciben los avisos (separados por coma).
# ALERTA_EMAIL_DESTINO=jefe@empresa.cl,otro@correo.com

# --- Servidor ---
# Opcional: la dirección de tu GitHub Pages para limitar quién usa la API
# CORS_ORIGIN=https://tu-usuario.github.io

# --- Login ---
# Texto largo y secreto para firmar las sesiones (inventa uno).
# Puedes generarlo con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=cambia-esto-por-un-texto-largo-y-secreto

# --- Aviso inmediato al agregar un extintor (solo en Render) ---
# Token de GitHub con permiso "Actions: Read and write" sobre el repositorio
# GITHUB_TOKEN=github_pat_xxxxxxxx
# GITHUB_REPO=tu-usuario/tu-repositorio
